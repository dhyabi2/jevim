# Model key for the agent's decisions (any nano-gpt key). Used by the Hermes plugin and by server/public.mjs.
NANO_API_KEY=
# Optional: path to Chrome/Chromium (auto-detected otherwise).
CHROME_PATH=

# --- Only for running the paid Vend gateway (vend-gateway/), not needed for the plugin ---
# Where settled payments go. Your own address; never a seed or key. The gateway refuses to start without it.
NANO_AGENT_ACCOUNT=
# Price of one hosted browser-agent run, in XNO.
VEND_PRICE_BROWSER_AGENT=0.05
# Where the agent server lives, and its own revocable key.
JEVIM_AGENT_URL=http://127.0.0.1:8790
JEVIM_AGENT_KEY=
# Checkout of https://github.com/dhyabi2/vend (MIT) that supplies the x402/XNO paywall.
VEND_DIR=/opt/vend
